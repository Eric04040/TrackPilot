{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "default_locale": "en",
  "version": "0.9.78",
  "homepage_url": "https://github.com/Eric04040/TrackPilot",
  "description": "__MSG_extDesc__",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage",
    "unlimitedStorage",
    "sidePanel"
  ],
  "host_permissions": [
    "https://bandcamp.com/*",
    "https://*.bandcamp.com/*",
    "https://*.bcbits.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "__MSG_actionTitle__",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "side_panel": {
    "default_path": "panel.html"
  },
  "sidebar_action": {
    "default_panel": "panel.html",
    "default_title": "__MSG_extName__",
    "default_icon": "icons/icon32.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://bandcamp.com/*",
        "https://*.bandcamp.com/*"
      ],
      "js": [
        "i18n.js",
        "bpm.js",
        "content.js",
        "bar.js"
      ]
    }
  ],
  "commands": {
    "toggle-panel": {
      "suggested_key": {
        "default": "Alt+T",
        "mac": "Alt+T"
      },
      "description": "__MSG_cmdToggle__"
    }
  }
}
